# runtime output
logs/
.state/
downloads/
downloads_test/
runtime/
*.log

# build artefacts
build/
dist/
build_*
__pycache__/
*.egg-info/

# .NET build output (frontend/). The Python tree has no bin/ or obj/, so these
# are safe to ignore repository-wide.
bin/
obj/
*.user

# environments / caches
.venv/
.pytest_cache/

# Windows creates this next to the repo when Game Bar records the screen.
# Not ours, but it shows up as untracked noise in every status.
Captures/

# generated PyInstaller specs; the maintained ones under packaging/ are tracked
*.spec
!packaging/pyinstaller/*.spec
