<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="clr-namespace:VideoDownloader.Desktop"
        x:Class="VideoDownloader.Desktop.MainWindow"
        x:DataType="desktop:MainWindowViewModel"
        Title="Video Downloader"
        Width="820" Height="560"
        MinWidth="460" MinHeight="340">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <!-- Header: what to download, where it goes, and who is signed in -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16" IsEnabled="{Binding IsConnected}">
      <TextBlock Text="Video Downloader" FontSize="20" FontWeight="SemiBold" />

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding NewJobUrl}" PlaceholderText="Video-URL hier einfügen..." />
        <TextBox Grid.Column="1" Text="{Binding Quality}" Width="90"
                 ToolTip.Tip="Qualität, z. B. best, 1080p oder 720p" />
        <Button Grid.Column="2" Content="Herunterladen" Command="{Binding AddJobCommand}" IsDefault="True" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Zielordner:" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding DownloadDirectoryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440" />
        <Button Content="Ändern..." Command="{Binding ChangeDirectoryCommand}" Padding="8,4" />
        <Button Content="Neu einlesen" Command="{Binding RescanCommand}" Padding="8,4"
                ToolTip.Tip="Den Zielordner erneut nach vorhandenen Videos durchsuchen" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding SiteLogins}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type desktop:SiteLoginViewModel}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              <Button Content="Anmelden..." Command="{Binding SignInCommand}" Padding="8,4" />
              <Button Content="Abmelden" Command="{Binding SignOutCommand}" Padding="8,4"
                      IsVisible="{Binding IsSignedIn}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Job list -->
    <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type desktop:JobViewModel}">
          <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12" Margin="0,4" Background="Transparent"
                  DoubleTapped="OnJobDoubleTapped">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Border IsVisible="{Binding FromDisk}" Background="{DynamicResource SystemControlBackgroundAccentBrush}"
                        CornerRadius="4" Padding="4,2">
                  <TextBlock Text="Vorhanden" FontSize="11" Foreground="White" />
                </Border>
              </StackPanel>

              <ProgressBar Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                           Margin="0,8" Height="6"
                           Value="{Binding Progress}"
                           IsIndeterminate="{Binding IsIndeterminate}" />

              <StackPanel Grid.Column="0" Grid.Row="2">
                <TextBlock Text="{Binding StatusLine}" Opacity="0.75" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" IsVisible="{Binding HasError}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8"
                          VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="Öffnen" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                <Button Content="Abbrechen" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}"
                        ToolTip.Tip="Anhalten; bereits Geladenes bleibt für einen späteren Neustart erhalten" />
                <Button Content="Entfernen" Command="{Binding RemoveCommand}"
                        ToolTip.Tip="Aus der Liste entfernen" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Footer: what just happened -->
    <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="4"
            Padding="8" Margin="0,16,0,0">
      <TextBlock Text="{Binding StatusText}" Opacity="0.75" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
