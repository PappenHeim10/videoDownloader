<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VideoDownloader.Desktop.ConfirmDialog"
        Title="Bestätigen"
        Width="350" Height="150"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Abbrechen" Click="OnCancelClick" />
            <Button Content="Bestätigen" Click="OnConfirmClick" Classes="accent" />
        </StackPanel>
    </Grid>
</Window>
